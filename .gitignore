# LifeCircle OS — Root .gitignore
# Governed by: docs/repository-structure.md | docs/coding-standards.md

# ── Secrets & Environment ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.local.example
!.env.example
.secrets.baseline

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.Python
pip-log.txt
pip-delete-this-directory.txt
.installed.cfg
*.pyo
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
coverage/
*.cover

# ── Dart / Flutter ────────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
doc/api/
*.iml
*.ipr
*.iws
*.class
*.log
*.lock
!pubspec.lock
!poetry.lock

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.fseventsd

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.history/

# ── Node (admin panel future) ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docker ────────────────────────────────────────────────────────────────────
infrastructure/docker/.env.local

# ── Terraform ─────────────────────────────────────────────────────────────────
infrastructure/**/.terraform/
infrastructure/**/*.tfstate
infrastructure/**/*.tfstate.*
infrastructure/**/.terraform.lock.hcl
infrastructure/**/crash.log
infrastructure/**/override.tf
infrastructure/**/override.tf.json
infrastructure/**/*_override.tf
infrastructure/**/*_override.tf.json

# ── Coverage & Reports ────────────────────────────────────────────────────────
apps/api/coverage.xml
apps/mobile/coverage/
*.lcov

# ── Melos ─────────────────────────────────────────────────────────────────────
.melos_tool/
melos_tool/

# ── Playwright ────────────────────────────────────────────────────────────────
