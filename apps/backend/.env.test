# LifeCircle OS — Local Environment Template
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file: cp .env.local.example .env.local
#   2. Replace ALL values marked ⚠ CHANGE THIS before first run
#   3. NEVER commit .env.local to version control
#   4. For production: values are injected via Doppler (see docs/sprint-zero-plan.md)
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=lifecircle_local
POSTGRES_USER=lifecircle
POSTGRES_PASSWORD=changeme_local_only  # ⚠ CHANGE THIS

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_local_only  # ⚠ CHANGE THIS
REDIS_URL=redis://:changeme_local_only@localhost:6379/0

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/lifecircle

# ── FastAPI / Backend ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lifecircle:changeme_local_only@localhost:5432/lifecircle_local
JWT_SECRET=changeme_local_only_must_be_at_least_32_characters_long  # ⚠ CHANGE THIS
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15
APP_ENV=local
APP_DEBUG=true
APP_PORT=8000
LOG_LEVEL=DEBUG

# ── Email (MailHog local SMTP) ────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@lifecircle.local

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REGISTER_PER_MINUTE=5

# ── Secrets (Doppler — local placeholder) ────────────────────────────────────
# In production and CI: DOPPLER_TOKEN is injected by the CI runner.
# Locally: values above serve as fallback when DOPPLER_TOKEN is not set.
# DOPPLER_TOKEN=dp.st.xxxx  # ⚠ Set if using Doppler locally
