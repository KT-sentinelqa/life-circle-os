{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifecircle.os/schemas/review-report/v1",
  "title": "LifeCircle Review Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "generated_at", "commit_sha", "milestone", "board", "decision", "findings", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_type": {"enum": ["architecture", "platform_evolution", "implementation", "security", "performance", "product", "data_governance", "release_certification"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "commit_sha": {"type": "string", "minLength": 7},
    "milestone": {"type": "string", "minLength": 1},
    "board": {"type": "string", "minLength": 1},
    "decision": {"enum": ["APPROVED", "APPROVED_WITH_CONDITIONS", "REJECTED"]},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "classification", "summary", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["P0", "P1", "P2", "P3"]},
          "classification": {"enum": ["BLOCKS_CURRENT_MILESTONE", "REQUIRED_BEFORE_FUTURE_MILESTONE", "ARCHITECTURE_DEBT", "ROADMAP_CAPABILITY", "UNVERIFIED"]},
          "required_before_milestone": {"type": "string"},
          "summary": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "metrics": {"type": "object", "additionalProperties": {"type": ["number", "string", "boolean"]}},
    "risk_acceptances": {"type": "array", "items": {"type": "string"}}
  }
}
